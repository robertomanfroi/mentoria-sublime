        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $env.WHATSAPP_GROUP_MENTORIA_ID, text: '✅ *Resumo pronto*\\n\\nO resumo da Mentoria Sublime com *' + $('Formata Resposta').first().json.nomeCurto + '* já foi organizado e salvo no Drive.\\n\\n📄 Arquivo: ' + $('Formata Resposta').first().json.docName + '\\n\\n🔗 Drive: https://drive.google.com/drive/folders/1si0pPBrHXbxUCz6TN1uH-EF39Md5n7Xs' }) }}",
        "options": {}
      }
    }
  ],
