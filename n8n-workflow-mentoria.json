        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ requests: [ { replaceAllText: { containsText: { text: '{{CONTEUDO}}', matchCase: true }, replaceText: $('Formata Resposta').first().json.resumoContent } }, { replaceAllText: { containsText: { text: '{{DATA}}', matchCase: true }, replaceText: $('Formata Resposta').first().json.dateFormatted } }, { replaceAllText: { containsText: { text: '{{NOME}}', matchCase: true }, replaceText: $('Formata Resposta').first().json.nomeCurto } } ] }) }}",
        "options": {}
      },
      "credentials": {
        "googleDocsOAuth2Api": {
          "id": "google-oauth2",
          "name": "Google Docs OAuth2"
        }
      }
    },
    {
