          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "1si0pPBrHXbxUCz6TN1uH-EF39Md5n7Xs",
          "mode": "id"
        },
        "binaryPropertyName": "pdfData",
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google-oauth2",
          "name": "Google Drive OAuth2"
        }
      }
    },
